APP_NAME=Serv5
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

# SQLite for local dev (change to mysql if using a MySQL server)
DB_CONNECTION=sqlite
# DB_DATABASE=database/database.sqlite
# For MySQL:
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=serv5
# DB_USERNAME=root
# DB_PASSWORD=

BROADCAST_CONNECTION=log
CACHE_STORE=database
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file

CORS_ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001"
TRUSTED_PROXIES="*"

HTTP_ALT_SVC_ENABLED=false
HTTP_OUTBOUND_VERSION=http1.1
HTTP_TCP_KEEPALIVE=true

AI_CONTENT_ENABLED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

ADMIN_EMAIL=admin@serv5.com
ADMIN_PASSWORD=admin123456
