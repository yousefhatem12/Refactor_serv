# Auto detect text files and perform LF normalization
* text=auto

# Binary files — never touch line endings
*.woff  binary
*.woff2 binary
*.ttf   binary
*.otf   binary
*.eot   binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.webp  binary
*.svg   binary
*.mp4   binary
*.webm  binary
*.zip   binary
*.gz    binary
